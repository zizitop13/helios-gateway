# Gateway environment example

# Server
PORT=4000

# Discovery mode: cloudrun or docker
DISCOVERY_MODE=docker
POLLING_INTERVAL_MS=30000

# Docker discovery
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Cloud Run discovery
GCP_PROJECT_ID=my-project-id
GCP_REGION=us-central1

# Firebase
FIREBASE_PROJECT_ID=my-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/serviceAccountKey.json

# Admin console Firebase web config (served by GET /admin/config/firebase)
# Required for admin console login: API_KEY, AUTH_DOMAIN, PROJECT_ID, APP_ID
ADMIN_CONSOLE_ENABLED=true
ENABLE_APOLLO_SANDBOX=false
ADMIN_CONSOLE_FIREBASE_API_KEY=
ADMIN_CONSOLE_FIREBASE_AUTH_DOMAIN=
ADMIN_CONSOLE_FIREBASE_PROJECT_ID=
ADMIN_CONSOLE_FIREBASE_APP_ID=

# Optional Firebase web fields
ADMIN_CONSOLE_FIREBASE_STORAGE_BUCKET=
ADMIN_CONSOLE_FIREBASE_MESSAGING_SENDER_ID=
ADMIN_CONSOLE_FIREBASE_MEASUREMENT_ID=

# Cloud Run IAM Authentication (optional)
# When enabled, the gateway will attach identity tokens to requests to downstream services
ENABLE_CLOUD_RUN_IAM_AUTH=false

# Dynamic schema refresh
ENABLE_SCHEMA_REFRESH=true
SCHEMA_REFRESH_INTERVAL_SECONDS=60

GRAPH_NAME=pet-shop
