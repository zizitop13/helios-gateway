{
  "name": "apollo-cloud-gateway",
  "version": "1.0.3",
  "description": "Apollo Federation Gateway with Firebase auth, RBAC, and Cloud Run auto-discovery",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "bin": {
    "apollo-gateway": "dist/cli.js",
    "apollo-cloud-gateway": "dist/cli.js"
  },
  "private": false,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev-gateway": "dotenv -e .env.local -- ts-node src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "publish:auth": "npx google-artifactregistry-auth --repo-config=%USERPROFILE%\\.npmrc --credential-config=%USERPROFILE%\\.npmrc",
    "release": "npm run publish:auth && npm publish"
  },
  "keywords": [
    "apollo",
    "federation",
    "gateway",
    "firebase",
    "rbac",
    "cloud-run"
  ],
  "bundleDependencies": [
    "@apollo/gateway",
    "@apollo/server",
    "@google-cloud/run",
    "@graphql-tools/utils",
    "cors",
    "dockerode",
    "dotenv",
    "express",
    "firebase-admin",
    "google-auth-library",
    "graphql",
    "graphql-tag",
    "yaml"
  ],
  "dependencies": {
    "@apollo/gateway": "^2.5.5",
    "@apollo/server": "^4.9.5",
    "@google-cloud/run": "^1.2.0",
    "@graphql-tools/utils": "^10.0.11",
    "cors": "^2.8.5",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^10.5.0",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.47",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest-junit": {
    "outputDirectory": "./reports/junit",
    "outputName": "junit.xml"
  }
}
