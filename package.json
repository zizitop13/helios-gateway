{
  "name": "helios-gateway-quality",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "build": "npm --prefix gateway run build && npm --prefix admin-console run build && npm --prefix testing/services/pets-shop-ui run build",
    "lint": "eslint --config eslint.config.mjs . --max-warnings 0",
    "analyze": "eslint --config eslint.sonar.config.mjs . --max-warnings 0",
    "test:unit": "npm --prefix gateway run test:ci -- --runInBand --json --outputFile=reports/unit.json",
    "test:mutation": "npm --prefix gateway run test:mutation",
    "test:e2e": "node testing/local/run.mjs e2e",
    "test:stress": "node testing/local/run.mjs stress",
    "check": "node scripts/check.mjs",
    "reports": "node scripts/reports.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-sonarjs": "^4.2.2",
    "firebase-tools": "^14.27.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.71.2"
  }
}
